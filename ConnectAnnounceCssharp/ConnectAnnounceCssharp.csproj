<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ConnectAnnounce</AssemblyName>
    <RootNamespace>ConnectAnnounce</RootNamespace>
    <Version>1.0.4</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.371" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="MaxMind.GeoIP2" Version="5.4.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\GeoLite2-City.mmdb" Link="GeoLite2-City.mmdb" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\GeoLite2-City.mmdb')" />
    <Content Include="data\cannounce_settings.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
